DATABASE_URL=postgresql+asyncpg://family:family123@localhost:5432/family_mission
# Supabase (staging/production): use Session pooler URI, e.g.
# postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
SECRET_KEY=change-this-to-a-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
# Render: set ENVIRONMENT=production and PORT is injected automatically
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PLATFORM_ADMIN_EMAIL=admin@familymission.local
PLATFORM_ADMIN_PASSWORD=change-this-admin-password
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
MAX_UPLOAD_BYTES=2097152

# Email & frontend URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=45
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Legal
REDEMPTION_MODE=symbolic
LEGAL_DOC_VERSION=1.0

# Redis (optional, production rate limiting)
REDIS_URL=

# Sentry (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
