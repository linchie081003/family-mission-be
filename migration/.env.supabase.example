# Supabase target database (jangan commit file ini)
# Salin ke .env.supabase dan isi password project Supabase Anda.
#
# Format (Session pooler, port 6543):
# TARGET_DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

TARGET_DATABASE_URL=
